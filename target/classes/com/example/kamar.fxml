<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.controller.KamarController"
            padding="15">

    <center>
        <TableView>
            <columns>
                <TableColumn text="ID Kamar"/>
                <TableColumn text="Tipe"/>
                <TableColumn text="Harga"/>
                <TableColumn text="Status"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <GridPane hgap="10" vgap="10">
                <Label text="ID Kamar" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tipe" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Harga" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Status" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Tambah"/>
                <Button text="Ubah"/>
                <Button text="Hapus"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
