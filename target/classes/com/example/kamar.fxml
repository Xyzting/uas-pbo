<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.example.controller.KamarController"
            prefHeight="600.0"
            prefWidth="800.0">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Tabel Kamar -->
    <center>
        <TableView fx:id="kamarTableView" 
                   BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idKamarColumn" 
                            text="ID Kamar" 
                            prefWidth="150.0"
                            minWidth="100.0"/>
                <TableColumn fx:id="tipeColumn" 
                            text="Tipe" 
                            prefWidth="200.0"
                            minWidth="150.0"/>
                <TableColumn fx:id="hargaColumn" 
                            text="Harga" 
                            prefWidth="200.0"
                            minWidth="150.0"/>
                <TableColumn fx:id="statusColumn" 
                            text="Status" 
                            prefWidth="150.0"
                            minWidth="100.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Form Input dan Tombol Aksi -->
    <bottom>
        <VBox spacing="15" 
              BorderPane.alignment="CENTER">
            
            <padding>
                <Insets top="15" right="0" bottom="0" left="0"/>
            </padding>
            
            <Separator/>
            
            <!-- Form Input -->
            <GridPane hgap="10" vgap="12" 
                     alignment="CENTER_LEFT">
                
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" 
                                      minWidth="100.0" 
                                      prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" 
                                      minWidth="200.0" 
                                      prefWidth="300.0"/>
                </columnConstraints>
                
                <!-- ID Kamar -->
                <Label text="ID Kamar:" 
                       GridPane.rowIndex="0" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="idKamarField" 
                          promptText="Masukkan ID Kamar"
                          GridPane.rowIndex="0" 
                          GridPane.columnIndex="1"/>

                <!-- Tipe -->
                <Label text="Tipe:" 
                       GridPane.rowIndex="1" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="tipeField" 
                          promptText="Contoh: Standard, Deluxe, Suite"
                          GridPane.rowIndex="1" 
                          GridPane.columnIndex="1"/>

                <!-- Harga -->
                <Label text="Harga:" 
                       GridPane.rowIndex="2" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="hargaField" 
                          promptText="Masukkan harga per malam"
                          GridPane.rowIndex="2" 
                          GridPane.columnIndex="1"/>

                <!-- Status -->
               <Label text="Status:" 
                     GridPane.rowIndex="3" 
                     GridPane.columnIndex="0"/>
               <ComboBox fx:id="statusComboBox" 
                        promptText="Pilih Status"
                        prefWidth="200.0"
                        GridPane.rowIndex="3" 
                        GridPane.columnIndex="1"/>
                
            </GridPane>

            <!-- Tombol Aksi -->
            <HBox spacing="10" 
                  alignment="CENTER_LEFT">
                
                <Button fx:id="tambahButton" 
                       text="Tambah" 
                       prefWidth="100.0"
                       styleClass="button-primary"/>
                       
                <Button fx:id="ubahButton" 
                       text="Ubah" 
                       prefWidth="100.0"
                       styleClass="button-secondary"/>
                       
                <Button fx:id="hapusButton" 
                       text="Hapus" 
                       prefWidth="100.0"
                       styleClass="button-danger"/>
                       
                <Button fx:id="resetButton" 
                       text="Reset" 
                       
                       prefWidth="100.0"/>
                       
            </HBox>
            
        </VBox>
    </bottom>

</BorderPane>