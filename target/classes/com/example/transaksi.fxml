<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
  xmlns="http://javafx.com/javafx/17"
  fx:controller="com.example.controller.TransaksiController"
  prefHeight="700.0"
  prefWidth="1100.0">

  <padding>
    <Insets top="15" right="15" bottom="15" left="15" />
  </padding>

  <!-- ================= TABLE TRANSAKSI ================= -->
  <center>
    <TableView fx:id="transaksiTableView" BorderPane.alignment="CENTER">
      <columns>
        <TableColumn fx:id="idTransaksiColumn" text="ID Transaksi" prefWidth="120" />
        <TableColumn fx:id="reservasiColumn" text="Reservasi" prefWidth="150" />
        <TableColumn fx:id="pelangganColumn" text="Pelanggan" prefWidth="180" />
        <TableColumn fx:id="kamarColumn" text="Kamar" prefWidth="120" />
        <TableColumn fx:id="totalBayarColumn" text="Total Bayar" prefWidth="150" />
        <TableColumn fx:id="metodeColumn" text="Metode Pembayaran" prefWidth="180" />
        <TableColumn fx:id="tanggalColumn" text="Tanggal" prefWidth="130" />
        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" />
      </columns>

      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>
  </center>

  <!-- ================= FORM BOTTOM ================= -->
  <bottom>
    <VBox spacing="15" BorderPane.alignment="CENTER">
      <padding>
        <Insets top="15" />
      </padding>

      <Separator />

      <HBox spacing="20">

        <!-- PANEL RESERVASI -->
        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="panel-box">
          <Label text="INFORMASI RESERVASI" styleClass="panel-title" />

          <GridPane hgap="10" vgap="10">
            <columnConstraints>
              <ColumnConstraints minWidth="120" />
              <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Reservasi:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <ComboBox fx:id="reservasiComboBox" promptText="Pilih Reservasi"
              GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Pelanggan:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="pelangganLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Kamar:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <Label fx:id="kamarLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Durasi:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <Label fx:id="durasiLabel" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1" />
          </GridPane>
        </VBox>

        <!-- PANEL PEMBAYARAN -->
        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="panel-box">
          <Label text="DETAIL PEMBAYARAN" styleClass="panel-title" />

          <GridPane hgap="10" vgap="10">
            <columnConstraints>
              <ColumnConstraints minWidth="120" />
              <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="ID Transaksi:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="idTransaksiField" editable="false"
              GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Subtotal:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="subtotalLabel" text="Rp 0" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Pajak (10%):" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <Label fx:id="pajakLabel" text="Rp 0" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Diskon:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <HBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="1">
              <TextField fx:id="diskonField" text="0" onKeyReleased="#handleDiskonChange" />
              <Label text="%" />
              <Label fx:id="diskonRpLabel" text="(Rp 0)" />
            </HBox>

            <Separator GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2" />

            <Label text="Total Bayar:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <Label fx:id="totalBayarLabel" text="Rp 0" GridPane.rowIndex="5"
              GridPane.columnIndex="1" />

            <Label text="Metode:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <ComboBox fx:id="metodeComboBox" promptText="Pilih Metode"
              GridPane.rowIndex="6" GridPane.columnIndex="1" />
          </GridPane>
        </VBox>

      </HBox>

      <!-- BUTTONS -->
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="bayarButton" text="Bayar Sekarang" />
        <Button fx:id="cetakButton" text="Cetak Struk" />
        <Button fx:id="resetButton" text="Reset" />

        <Region HBox.hgrow="ALWAYS" />

        <Label text="Status:" />
        <Label fx:id="statusPembayaranLabel" text="Siap untuk pembayaran" />
      </HBox>

    </VBox>
  </bottom>

</BorderPane>