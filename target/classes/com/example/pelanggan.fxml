<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.example.controller.PelangganController"
            prefHeight="700.0"
            prefWidth="900.0"
            style="-fx-background-color: white;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Tabel Pelanggan -->
    <center>
        <TableView fx:id="pelangganTableView" 
                   BorderPane.alignment="CENTER"
                   style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="idColumn" 
                            text="ID" 
                            prefWidth="80.0"
                            minWidth="60.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="namaColumn" 
                            text="Nama" 
                            prefWidth="180.0"
                            minWidth="120.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="noHpColumn" 
                            text="No HP" 
                            prefWidth="130.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="alamatColumn" 
                            text="Alamat" 
                            prefWidth="220.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="emailColumn" 
                            text="Email" 
                            prefWidth="200.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Form Input dan Tombol Aksi -->
    <bottom>
        <VBox spacing="15" 
              BorderPane.alignment="CENTER">
            
            <padding>
                <Insets top="15" right="0" bottom="0" left="0"/>
            </padding>
            
            <Separator style="-fx-background-color: #ecf0f1;"/>
            
            <!-- Form Input -->
            <GridPane hgap="10" vgap="12" 
                     alignment="CENTER_LEFT">
                
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" 
                                      minWidth="100.0" 
                                      prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" 
                                      minWidth="200.0" 
                                      prefWidth="400.0"/>
                </columnConstraints>
                
                <!-- ID Pelanggan -->
                <Label text="ID:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="0" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="idField" 
                          promptText="ID akan terisi otomatis"
                          editable="false"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="0" 
                          GridPane.columnIndex="1"/>

                <!-- Nama -->
                <Label text="Nama:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="1" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="namaField" 
                          promptText="Masukkan nama lengkap pelanggan"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="1" 
                          GridPane.columnIndex="1"/>

                <!-- No HP -->
                <Label text="No HP:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="2" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="noHpField" 
                          promptText="Contoh: 081234567890"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="2" 
                          GridPane.columnIndex="1"/>

                <!-- Alamat -->
                <Label text="Alamat:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="3" 
                       GridPane.columnIndex="0"/>
                <TextArea fx:id="alamatField" 
                         promptText="Masukkan alamat lengkap"
                         prefRowCount="3"
                         wrapText="true"
                         style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                         GridPane.rowIndex="3" 
                         GridPane.columnIndex="1"/>

                <!-- Email -->
                <Label text="Email:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="4" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" 
                          promptText="Contoh: pelanggan@email.com"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="4" 
                          GridPane.columnIndex="1"/>
                
            </GridPane>

            <!-- Tombol Aksi -->
            <HBox spacing="10" 
                  alignment="CENTER_LEFT">
                
                <Button fx:id="tambahButton" 
                       text="Tambah" 
                       prefWidth="100.0"
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="ubahButton" 
                       text="Ubah" 
                       prefWidth="100.0"
                       style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand;"/>
                       
                <Button fx:id="hapusButton" 
                       text="Hapus" 
                       prefWidth="100.0"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="resetButton" 
                       text="Reset" 
                       prefWidth="100.0"
                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="cariButton" 
                       text="Cari" 
                       prefWidth="100.0"
                       style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
            </HBox>
            
        </VBox>
    </bottom>

</BorderPane>