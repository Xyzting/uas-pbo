<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/17"
           fx:controller="com.example.controller.FormLoginController">

    <!-- Container Utama - Responsif -->
    <HBox spacing="0" 
          alignment="CENTER"
          style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        
        <StackPane.margin>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </StackPane.margin>
        
        <!-- Panel Kiri: Informasi/Banner -->
        <VBox alignment="CENTER" 
              spacing="20"
              style="-fx-background-color: linear-gradient(to bottom, #2563eb, #1d4ed8); -fx-background-radius: 10 0 0 10;"
              HBox.hgrow="SOMETIMES">
            
            <padding>
                <Insets top="40" right="30" bottom="40" left="30"/>
            </padding>
            
            <Label text="🏨" 
                   style="-fx-font-size: 64px;"/>
            
            <Label text="Sistem Reservasi Hotel" 
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"
                   wrapText="true"
                   textAlignment="CENTER"
                   maxWidth="300"/>
            
            <Label text="Kelola hotel Anda dengan mudah dan efisien" 
                   style="-fx-text-fill: #e0e7ff; -fx-font-size: 14px;"
                   wrapText="true"
                   textAlignment="CENTER"
                   maxWidth="300"/>
            
        </VBox>
        
        <!-- Panel Kanan: Form Login -->
        <VBox alignment="CENTER" 
              spacing="20"
              HBox.hgrow="SOMETIMES">
            
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>
            
            <!-- Header -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Selamat Datang!" 
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                <Label text="Masuk ke akun Anda" 
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
            </VBox>
            
            <!-- Form Fields -->
            <VBox spacing="18" 
                  VBox.vgrow="SOMETIMES">
                
                <!-- Username Field -->
                <VBox spacing="8">
                    <Label text="Username" 
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                    <TextField fx:id="usernameField" 
                              promptText="Masukkan username"
                              prefHeight="40"
                              style="-fx-font-size: 14px; -fx-padding: 12; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                </VBox>
                
                <!-- Password Field -->
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Password" 
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"
                               HBox.hgrow="ALWAYS"/>
                        <Hyperlink fx:id="forgotPasswordLink" 
                                  text="Lupa Password?" 
                                  style="-fx-font-size: 12px; -fx-text-fill: #2563eb;"/>
                    </HBox>
                    <PasswordField fx:id="passwordField" 
                                  promptText="Masukkan password"
                                  prefHeight="40"
                                  style="-fx-font-size: 14px; -fx-padding: 12; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                </VBox>
                
                <!-- Remember Me -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <CheckBox fx:id="rememberMeCheckBox" 
                             text="Ingat saya"
                             style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>
                </HBox>
                
                <!-- Error Message -->
                <Label fx:id="errorLabel" 
                       text="" 
                       textFill="red"
                       wrapText="true"
                       style="-fx-font-size: 12px;"
                       visible="false"
                       managed="false"/>
                
                <!-- Login Button -->
                <Button fx:id="loginButton" 
                       text="Masuk" 
                       onAction="#handleLogin"
                       prefHeight="45.0"
                       maxWidth="Infinity"
                       style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
                
                <!-- Divider -->
                <HBox spacing="10" alignment="CENTER" maxWidth="Infinity">
                    <Separator HBox.hgrow="ALWAYS"/>
                    <Label text="atau" 
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
                    <Separator HBox.hgrow="ALWAYS"/>
                </HBox>
                
                <!-- Register Link -->
                <HBox spacing="5" alignment="CENTER">
                    <Label text="Belum punya akun?" 
                           style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    <Hyperlink fx:id="registerLink" 
                              text="Daftar sekarang" 
                              style="-fx-font-size: 13px; -fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                </HBox>
                
            </VBox>
            
            <!-- Footer -->
            <Label text="© 2025 Hotel Management System by kelompok rehan" 
                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"
                   wrapText="true"
                   textAlignment="CENTER"/>
            
        </VBox>
        
    </HBox>

</StackPane>
