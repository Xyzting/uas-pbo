<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/17"
           fx:controller="com.example.controller.LoginController"
           style="-fx-background-color: #f8f9fa;"
           alignment="CENTER">

    <!-- Container Utama -->
    <VBox spacing="40" alignment="CENTER" maxWidth="1000">
        
        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>
        
        <!-- Banner Header -->
        <VBox alignment="CENTER" spacing="10">
            
            <!-- Icon Hotel -->
            <Label text="🏨" 
                   style="-fx-font-size: 72px;"/>
            
            <!-- Title -->
            <Label text="Sistem Reservasi Hotel" 
                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="36"/>
                </font>
            </Label>
            
            <!-- Subtitle -->
            <Label text="Kelola hotel Anda dengan mudah dan efisien" 
                   style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            
        </VBox>
        
        <!-- Container untuk 2 Card -->
        <HBox spacing="30" 
              alignment="CENTER">
            
            <!-- Card Login User -->
            <VBox alignment="CENTER" 
                  spacing="20"
                  prefWidth="350"
                  prefHeight="300"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                
                <padding>
                    <Insets top="40" right="30" bottom="40" left="30"/>
                </padding>
                
                <!-- Icon Placeholder -->
                <Label text="👤" 
                       style="-fx-font-size: 80px;"/>
                
                <!-- Title -->
                <Label text="Login User" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <!-- Description -->
                <Label text="Klik untuk masuk ke halaman user." 
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                       wrapText="true"
                       textAlignment="CENTER"
                       maxWidth="280"/>
                
                <!-- Button -->
                <Button fx:id="loginUserButton"
                        text="Masuk Sebagai User"
                        onAction="#handleLoginUser"
                        prefWidth="280"
                        prefHeight="45"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>
                </Button>
                
            </VBox>
            
            <!-- Card Login Admin -->
            <VBox alignment="CENTER" 
                  spacing="20"
                  prefWidth="350"
                  prefHeight="300"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
                
                <padding>
                    <Insets top="40" right="30" bottom="40" left="30"/>
                </padding>
                
                <!-- Icon Placeholder -->
                <Label text="🔒" 
                       style="-fx-font-size: 80px;"/>
                
                <!-- Title -->
                <Label text="Login Admin" 
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <!-- Description -->
                <Label text="Klik untuk masuk ke halaman login Admin." 
                       style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"
                       wrapText="true"
                       textAlignment="CENTER"
                       maxWidth="280"/>
                
                <!-- Button -->
                <Button fx:id="loginAdminButton"
                        text="Masuk Sebagai Admin"
                        onAction="#handleLoginAdmin"
                        prefWidth="280"
                        prefHeight="45"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="14"/>
                    </font>
                </Button>
                
            </VBox>
            
        </HBox>
        
        <!-- Footer -->
        <Label text="© 2025 Hotel Management System by kelompok rehan" 
               style="-fx-font-size: 12px; -fx-text-fill: #95a5a6;"/>
        
    </VBox>

</StackPane>