<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
  xmlns="http://javafx.com/javafx/17"
  fx:controller="com.example.controller.TransaksiController"
  prefHeight="700.0"
  prefWidth="1200.0"
  styleClass="root">

  <stylesheets>
    <URL value="@app.css" />
  </stylesheets>

  <padding>
    <Insets top="20" right="20" bottom="20" left="20" />
  </padding>

  <center>
    <TableView fx:id="transaksiTableView" BorderPane.alignment="CENTER">
      <columns>
        <TableColumn fx:id="idTransaksiColumn" text="ID Transaksi" prefWidth="120.0" />
        <TableColumn fx:id="reservasiColumn" text="Reservasi" prefWidth="120.0" />
        <TableColumn fx:id="pelangganColumn" text="Pelanggan" prefWidth="150.0" />
        <TableColumn fx:id="kamarColumn" text="Kamar" prefWidth="120.0" />
        <TableColumn fx:id="totalBayarColumn" text="Total Bayar" prefWidth="130.0" />
        <TableColumn fx:id="metodeColumn" text="Metode Pembayaran" prefWidth="140.0" />
        <TableColumn fx:id="tanggalColumn" text="Tanggal" prefWidth="100.0" />
        <TableColumn fx:id="statusColumn" text="Status" prefWidth="80.0" />
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>
  </center>

  <bottom>
    <VBox spacing="15" BorderPane.alignment="CENTER" styleClass="card">
      <BorderPane.margin>
        <Insets top="20" />
      </BorderPane.margin>

      <HBox spacing="30">
        <!-- INFORMASI RESERVASI -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
          <Label text="INFORMASI RESERVASI" styleClass="section-title" />

          <GridPane hgap="15" vgap="10">
            <columnConstraints>
              <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
              <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
            </columnConstraints>

            <Label text="Reservasi:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <ComboBox fx:id="reservasiComboBox" promptText="Pilih Reservasi" prefWidth="250.0"
              GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Pelanggan:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="pelangganLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Kamar:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <Label fx:id="kamarLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Durasi:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <Label fx:id="durasiLabel" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1" />
          </GridPane>
        </VBox>

        <!-- DETAIL PEMBAYARAN -->
        <VBox spacing="10" HBox.hgrow="ALWAYS">
          <Label text="DETAIL PEMBAYARAN" styleClass="section-title" />

          <GridPane hgap="15" vgap="10">
            <columnConstraints>
              <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
              <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
            </columnConstraints>

            <Label text="ID Transaksi:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="idTransaksiField" editable="false" promptText="Auto-generated"
              GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Subtotal:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="subtotalLabel" text="Rp 0" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Pajak (10%):" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <Label fx:id="pajakLabel" text="Rp 0" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Diskon:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1">
              <TextField fx:id="diskonField" text="0" prefWidth="60.0" />
              <Label text="/%" />
              <Label fx:id="diskonNominalLabel" text="(Rp 0)" />
            </HBox>

            <Label text="Total Bayar:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <Label fx:id="totalBayarLabel" text="Rp 0" styleClass="total-label"
              GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <Label text="Metode:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <ComboBox fx:id="metodeComboBox" promptText="Pilih Metode" pnarefWidth="150.0"
              GridPane.rowIndex="5" GridPane.columnIndex="1" />
          </GridPane>
        </VBox>
      </HBox>

      <!-- Buttons & Status -->
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="bayarButton" text="Bayar Sekarang" styleClass="btn-primary" prefWidth="130" />
        <Button fx:id="cetakStrukButton" text="Cetak Struk" styleClass="btn-outline" prefWidth="110" />
        <Button fx:id="resetButton" text="Reset" styleClass="btn-danger" prefWidth="80" />

        <Region HBox.hgrow="ALWAYS" />

        <Label text="Status:" />
        <Label fx:id="statusLabel" text="Siap untuk pembayaran" styleClass="status-label" />
      </HBox>
    </VBox>
  </bottom>

</BorderPane>