<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.example.controller.TransaksiController"
            prefHeight="700.0"
            prefWidth="1100.0"
            style="-fx-background-color: white;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Tabel Transaksi -->
    <center>
        <TableView fx:id="transaksiTableView" 
                   BorderPane.alignment="CENTER"
                   style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="idTransaksiColumn" 
                            text="ID Transaksi" 
                            prefWidth="120.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="reservasiColumn" 
                            text="Reservasi" 
                            prefWidth="150.0"
                            minWidth="120.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="pelangganColumn" 
                            text="Pelanggan" 
                            prefWidth="180.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="kamarColumn" 
                            text="Kamar" 
                            prefWidth="120.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="totalBayarColumn" 
                            text="Total Bayar" 
                            prefWidth="150.0"
                            minWidth="120.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="metodeColumn" 
                            text="Metode Pembayaran" 
                            prefWidth="180.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="tanggalColumn" 
                            text="Tanggal" 
                            prefWidth="130.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="statusColumn" 
                            text="Status" 
                            prefWidth="120.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Form Input dan Tombol Aksi -->
    <bottom>
        <VBox spacing="15" 
              BorderPane.alignment="CENTER">
            
            <padding>
                <Insets top="15" right="0" bottom="0" left="0"/>
            </padding>
            
            <Separator style="-fx-background-color: #ecf0f1;"/>
            
            <!-- Info Reservasi & Detail Pembayaran -->
            <HBox spacing="20">
                
                <!-- Panel Kiri: Pilih Reservasi -->
                <VBox spacing="12" 
                      HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #f8f9fa;">
                    
                    <Label text="INFORMASI RESERVASI" 
                           style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>
                    
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" 
                                              minWidth="120.0" 
                                              prefWidth="120.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" 
                                              minWidth="250.0" 
                                              prefWidth="300.0"/>
                        </columnConstraints>
                        
                        <Label text="Reservasi:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                               GridPane.rowIndex="0" 
                               GridPane.columnIndex="0"/>
                        <ComboBox fx:id="reservasiComboBox" 
                                 promptText="Pilih Reservasi yang sudah Check-out"
                                 prefWidth="300.0"
                                 style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                                 GridPane.rowIndex="0" 
                                 GridPane.columnIndex="1">
                            <tooltip>
                                <Tooltip text="Pilih reservasi yang siap dibayar"/>
                            </tooltip>
                        </ComboBox>
                        
                        <Label text="Pelanggan:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="1" 
                               GridPane.columnIndex="0"/>
                        <Label fx:id="pelangganLabel" 
                               text="-"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="1" 
                               GridPane.columnIndex="1"/>
                        
                        <Label text="Kamar:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="2" 
                               GridPane.columnIndex="0"/>
                        <Label fx:id="kamarLabel" 
                               text="-"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="2" 
                               GridPane.columnIndex="1"/>
                        
                        <Label text="Durasi:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="3" 
                               GridPane.columnIndex="0"/>
                        <Label fx:id="durasiLabel" 
                               text="-"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="3" 
                               GridPane.columnIndex="1"/>
                    </GridPane>
                    
                </VBox>
                
                <!-- Panel Kanan: Detail Pembayaran -->
                <VBox spacing="12" 
                      HBox.hgrow="ALWAYS"
                      style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #f8f9fa;">
                    
                    <Label text="DETAIL PEMBAYARAN" 
                           style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #2c3e50;"/>
                    
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" 
                                              minWidth="120.0" 
                                              prefWidth="120.0"/>
                            <ColumnConstraints hgrow="SOMETIMES" 
                                              minWidth="250.0" 
                                              prefWidth="300.0"/>
                        </columnConstraints>
                        
                        <Label text="ID Transaksi:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                               GridPane.rowIndex="0" 
                               GridPane.columnIndex="0"/>
                        <TextField fx:id="idTransaksiField" 
                                  promptText="ID akan terisi otomatis"
                                  editable="false"
                                  style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                                  GridPane.rowIndex="0" 
                                  GridPane.columnIndex="1"/>
                        
                        <Label text="Subtotal:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="1" 
                               GridPane.columnIndex="0"/>
                        <Label fx:id="subtotalLabel" 
                               text="Rp 0"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="1" 
                               GridPane.columnIndex="1"/>
                        
                        <Label text="Pajak (10%):" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="2" 
                               GridPane.columnIndex="0"/>
                        <Label fx:id="pajakLabel" 
                               text="Rp 0"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="2" 
                               GridPane.columnIndex="1"/>
                        
                        <Label text="Diskon:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="3" 
                               GridPane.columnIndex="0"/>
                        <HBox spacing="5" 
                              GridPane.rowIndex="3" 
                              GridPane.columnIndex="1">
                            <TextField fx:id="diskonField" 
                                      text="0"
                                      prefWidth="100.0"
                                      style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                                      onKeyReleased="#handleDiskonChange"/>
                            <Label text="%" 
                                   style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                            <Label fx:id="diskonRpLabel" 
                                   text="(Rp 0)"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>
                        </HBox>
                        
                        <Separator GridPane.rowIndex="4" 
                                  GridPane.columnIndex="0" 
                                  GridPane.columnSpan="2"
                                  style="-fx-background-color: #bdc3c7;"/>
                        
                        <Label text="Total Bayar:" 
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="5" 
                               GridPane.columnIndex="0"/>
                        <Label fx:id="totalBayarLabel" 
                               text="Rp 0"
                               style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #e74c3c; -fx-font-family: 'Segoe UI';"
                               GridPane.rowIndex="5" 
                               GridPane.columnIndex="1"/>
                        
                        <Label text="Metode:" 
                               style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                               GridPane.rowIndex="6" 
                               GridPane.columnIndex="0"/>
                        <ComboBox fx:id="metodeComboBox" 
                            promptText="Pilih Metode"
                            prefWidth="200.0"
                            style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                            GridPane.rowIndex="6" 
                            GridPane.columnIndex="1"/>
                        
                    </GridPane>
                    
                </VBox>
                
            </HBox>

            <!-- Tombol Aksi -->
            <HBox spacing="10" 
                  alignment="CENTER_LEFT">
                
                <Button fx:id="bayarButton" 
                       text="💳 Bayar Sekarang" 
                       prefWidth="160.0"
                       prefHeight="35.0"
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="cetakButton" 
                       text="🖨 Cetak Struk" 
                       prefWidth="140.0"
                       style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand;"/>
                       
                <Button fx:id="resetButton" 
                       text="Reset" 
                       prefWidth="100.0"
                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Region HBox.hgrow="ALWAYS"/>
                
                <Label text="Status: " 
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="statusPembayaranLabel" 
                       text="Siap untuk pembayaran"
                       style="-fx-text-fill: #27ae60; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                       
            </HBox>
            
        </VBox>
    </bottom>

</BorderPane>