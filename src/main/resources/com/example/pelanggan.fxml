<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
  xmlns="http://javafx.com/javafx/17"
  fx:controller="com.example.controller.PelangganController"
  prefHeight="700.0"
  prefWidth="900.0"
  styleClass="root">

  <stylesheets>
    <URL value="@app.css" />
  </stylesheets>

  <padding>
    <Insets top="20" right="20" bottom="20" left="20" />
  </padding>

  <center>
    <TableView fx:id="pelangganTableView" BorderPane.alignment="CENTER">
      <columns>
        <TableColumn fx:id="idColumn" text="ID" prefWidth="100" />
        <TableColumn fx:id="namaColumn" text="Nama" prefWidth="200" />
        <TableColumn fx:id="noTelpColumn" text="No. Telp" prefWidth="130" />
        <TableColumn fx:id="alamatColumn" text="Alamat" prefWidth="250" />
        <TableColumn fx:id="ktpColumn" text="No. KTP" prefWidth="150" />
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>
  </center>

  <bottom>
    <VBox spacing="20" BorderPane.alignment="CENTER" styleClass="card">
      <BorderPane.margin>
        <Insets top="20" />
      </BorderPane.margin>

      <GridPane hgap="15" vgap="15">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
        </columnConstraints>

        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="idField" editable="false"
          GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Nama:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextField fx:id="namaField"
          GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="No. Telp:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="noTelpField"
          GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="No. KTP:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <TextField fx:id="noKtpField"
          GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Alamat:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <TextArea fx:id="alamatField" prefRowCount="3" GridPane.rowIndex="4"
          GridPane.columnIndex="1" />
      </GridPane>

      <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="tambahButton" text="Tambah"
          styleClass="btn-primary" />
        <Button fx:id="ubahButton" text="Ubah"
          styleClass="btn-outline" />
        <Button fx:id="hapusButton" text="Hapus"
          styleClass="btn-danger" />
        <Button text="Reset" onAction="#resetForm" styleClass="btn-muted" />
      </HBox>
    </VBox>
  </bottom>

</BorderPane>