<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.example.controller.PelangganController"
            prefHeight="700.0"
            prefWidth="900.0"
            styleClass="root">

    <stylesheets>
        <URL value="@app.css" />
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <center>
        <TableView fx:id="pelangganTableView" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="80.0" />
                <TableColumn fx:id="namaColumn" text="Nama" prefWidth="180.0" />
                <TableColumn fx:id="noHpColumn" text="No HP" prefWidth="130.0" />
                <TableColumn fx:id="alamatColumn" text="Alamat" prefWidth="220.0" />
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="20" BorderPane.alignment="CENTER" styleClass="card">
            <BorderPane.margin>
                <Insets top="20" />
            </BorderPane.margin>
            
            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
                </columnConstraints>
                
                <Label text="ID Pelanggan" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="idField" promptText="Otomatis" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Nama Lengkap" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="namaField" promptText="Masukkan nama pelanggan" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Nomor HP" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="noHpField" promptText="Contoh: 0812..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Alamat" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="alamatField" promptText="Masukkan alamat lengkap" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Email" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" promptText="pelanggan@email.com" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="tambahButton" text="Tambah" styleClass="btn-primary" prefWidth="110"/>
                <Button fx:id="ubahButton" text="Ubah" styleClass="btn-outline" prefWidth="110"/>
                <Button fx:id="hapusButton" text="Hapus" styleClass="btn-danger" prefWidth="110"/>
                <Button fx:id="resetButton" text="Reset" styleClass="btn-muted" prefWidth="110"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="cariButton" text="Cari Data" styleClass="btn-success" prefWidth="110"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>