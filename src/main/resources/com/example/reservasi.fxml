<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
  xmlns="http://javafx.com/javafx/17"
  fx:controller="com.example.controller.ReservasiController"
>

  <padding>
    <Insets top="15" right="15" bottom="15" left="15" />
  </padding>

  <top>
    <VBox spacing="10" BorderPane.alignment="CENTER">
      <padding>
        <Insets bottom="10" />
      </padding>

      <Label text="Reservasi Hotel" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      <Separator />
    </VBox>
  </top>

  <center>
    <TableView fx:id="reservasiTableView" BorderPane.alignment="CENTER">
      <columns>
        <TableColumn fx:id="idReservasiColumn" text="ID Reservasi" prefWidth="120" />
        <TableColumn fx:id="pelangganColumn" text="Pelanggan" prefWidth="200" />
        <TableColumn fx:id="kamarColumn" text="Kamar" prefWidth="150" />
        <TableColumn fx:id="checkInColumn" text="Check-in" prefWidth="130" />
        <TableColumn fx:id="checkOutColumn" text="Check-out" prefWidth="130" />
        <TableColumn fx:id="durasiColumn" text="Durasi (Hari)" prefWidth="110" />
        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" />
      </columns>
      <columnResizePolicy>
        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
      <placeholder>
        <Label text="Tidak ada data reservasi. Klik 'Tambah Reservasi' untuk membuat booking baru."
          style="-fx-text-fill: gray;" />
      </placeholder>
    </TableView>
  </center>

  <bottom>
    <VBox spacing="15" BorderPane.alignment="CENTER">

      <padding>
        <Insets top="15" right="0" bottom="0" left="0" />
      </padding>

      <Separator />

      <GridPane hgap="10" vgap="12" alignment="CENTER_LEFT">

        <columnConstraints>
          <ColumnConstraints minWidth="120" prefWidth="120" />
          <ColumnConstraints minWidth="250" prefWidth="350" hgrow="SOMETIMES" />
          <ColumnConstraints minWidth="120" prefWidth="120" />
          <ColumnConstraints minWidth="250" prefWidth="350" hgrow="SOMETIMES" />
        </columnConstraints>

        <Label text="ID Reservasi:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="idReservasiField" editable="false"
          style="-fx-background-color: #f0f0f0;"
          GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Pelanggan:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
        <HBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="3">
          <ComboBox fx:id="pelangganComboBox" promptText="Pilih Pelanggan"
            HBox.hgrow="ALWAYS" prefWidth="250" />
          <Button fx:id="pelangganBaruButton" text="➕ Baru"
            styleClass="btn-success" />
        </HBox>

        <Label text="Kamar:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <HBox spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1">
          <ComboBox fx:id="kamarComboBox" promptText="Pilih Kamar"
            HBox.hgrow="ALWAYS" />
          <Button fx:id="refreshKamarButton" text="⟳" styleClass="btn-primary" />
        </HBox>

        <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
        <ComboBox fx:id="statusComboBox" promptText="Pilih Status"
          editable="false"
          GridPane.rowIndex="1" GridPane.columnIndex="3" />

        <Label text="Check-in:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <DatePicker fx:id="checkInDatePicker"
          GridPane.rowIndex="2" GridPane.columnIndex="1"
          prefWidth="350" />

        <Label text="Check-out:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
        <DatePicker fx:id="checkOutDatePicker"
          GridPane.rowIndex="2" GridPane.columnIndex="3"
          prefWidth="350" />

        <Label text="Durasi:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <Label fx:id="durasiLabel" text="- hari"
          style="-fx-font-size: 14px; -fx-font-weight: bold;"
          GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Total Harga:" GridPane.rowIndex="3" GridPane.columnIndex="2" />
        <Label fx:id="totalHargaLabel" text="Rp 0"
          style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
          GridPane.rowIndex="3" GridPane.columnIndex="3" />

      </GridPane>

      <HBox spacing="10" alignment="CENTER_LEFT">

        <Button fx:id="tambahButton" text="Tambah Reservasi"
          styleClass="btn-primary"
          style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" />

        <Button fx:id="ubahButton" text="Ubah"
          styleClass="btn-outline"
          style="-fx-background-color: #2196F3; -fx-text-fill: white;" />

        <Button fx:id="batalkanButton" text="Batalkan"
          styleClass="btn-danger"
          style="-fx-background-color: #F44336; -fx-text-fill: white;" />

        <Button fx:id="resetButton" text="Reset"
          styleClass="btn-muted"
          style="-fx-background-color: #9E9E9E; -fx-text-fill: white;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="checkInButton" text="✓ Check-in"
          styleClass="btn-success"
        />

        <Button fx:id="checkOutButton" text="✓ Check-out"
          styleClass="btn-success"
        />

      </HBox>

      <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
        <Label text="Tips: Klik header kolom untuk sorting."
          style="-fx-text-fill: #757575; -fx-font-size: 11px;" />
      </HBox>

    </VBox>
  </bottom>

</BorderPane>