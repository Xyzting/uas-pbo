<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.example.controller.ReservasiController"
            prefHeight="700.0"
            prefWidth="1000.0"
            style="-fx-background-color: white;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Tabel Reservasi -->
    <center>
        <TableView fx:id="reservasiTableView" 
                   BorderPane.alignment="CENTER"
                   style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="idReservasiColumn" 
                            text="ID Reservasi" 
                            prefWidth="120.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="pelangganColumn" 
                            text="Pelanggan" 
                            prefWidth="200.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="kamarColumn" 
                            text="Kamar" 
                            prefWidth="150.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="checkInColumn" 
                            text="Check-in" 
                            prefWidth="130.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="checkOutColumn" 
                            text="Check-out" 
                            prefWidth="130.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="durasiColumn" 
                            text="Durasi (Hari)" 
                            prefWidth="110.0"
                            minWidth="90.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="statusColumn" 
                            text="Status" 
                            prefWidth="120.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Form Input dan Tombol Aksi -->
    <bottom>
        <VBox spacing="15" 
              BorderPane.alignment="CENTER">
            
            <padding>
                <Insets top="15" right="0" bottom="0" left="0"/>
            </padding>
            
            <Separator style="-fx-background-color: #ecf0f1;"/>
            
            <!-- Form Input -->
            <GridPane hgap="10" vgap="12" 
                     alignment="CENTER_LEFT">
                
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" 
                                      minWidth="120.0" 
                                      prefWidth="120.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" 
                                      minWidth="250.0" 
                                      prefWidth="350.0"/>
                    <ColumnConstraints hgrow="NEVER" 
                                      minWidth="120.0" 
                                      prefWidth="120.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" 
                                      minWidth="250.0" 
                                      prefWidth="350.0"/>
                </columnConstraints>
                
                <!-- Baris 1: ID Reservasi & Pelanggan -->
                <Label text="ID Reservasi:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="0" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="idReservasiField" 
                          promptText="ID akan terisi otomatis"
                          editable="false"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="0" 
                          GridPane.columnIndex="1"/>
                
                <Label text="Pelanggan:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="0" 
                       GridPane.columnIndex="2"/>
                <ComboBox fx:id="pelangganComboBox" 
                         promptText="Pilih Pelanggan"
                         prefWidth="350.0"
                         style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                         GridPane.rowIndex="0" 
                         GridPane.columnIndex="3">
                    <tooltip>
                        <Tooltip text="Pilih pelanggan dari daftar yang ada"/>
                    </tooltip>
                </ComboBox>

                <!-- Baris 2: Kamar & Status -->
                <Label text="Kamar:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="1" 
                       GridPane.columnIndex="0"/>
                <HBox spacing="10" 
                      GridPane.rowIndex="1" 
                      GridPane.columnIndex="1">
                    <ComboBox fx:id="kamarComboBox" 
                             promptText="Pilih Kamar Tersedia"
                             prefWidth="250.0"
                             style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';">
                        <tooltip>
                            <Tooltip text="Hanya menampilkan kamar yang tersedia"/>
                        </tooltip>
                    </ComboBox>
                    <Button fx:id="refreshKamarButton" 
                           text="⟳" 
                           prefWidth="40.0"
                           style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10; -fx-cursor: hand;"/>
                </HBox>
                
                <Label text="Status:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="1" 
                       GridPane.columnIndex="2"/>
                <ComboBox fx:id="statusComboBox" 
                        promptText="Pilih Status"
                        prefWidth="200.0"
                        style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                        GridPane.rowIndex="1" 
                        GridPane.columnIndex="3"/>

                <!-- Baris 3: Check-in & Check-out -->
                <Label text="Check-in:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="2" 
                       GridPane.columnIndex="0"/>
                <DatePicker fx:id="checkInDatePicker" 
                           promptText="Pilih tanggal check-in"
                           prefWidth="350.0"
                           style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                           GridPane.rowIndex="2" 
                           GridPane.columnIndex="1">
                    <tooltip>
                        <Tooltip text="Pilih tanggal check-in"/>
                    </tooltip>
                </DatePicker>
                
                <Label text="Check-out:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="2" 
                       GridPane.columnIndex="2"/>
                <DatePicker fx:id="checkOutDatePicker" 
                           promptText="Pilih tanggal check-out"
                           prefWidth="350.0"
                           style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                           GridPane.rowIndex="2" 
                           GridPane.columnIndex="3">
                    <tooltip>
                        <Tooltip text="Pilih tanggal check-out"/>
                    </tooltip>
                </DatePicker>

                <!-- Baris 4: Info Durasi & Total Harga -->
                <Label text="Durasi:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="3" 
                       GridPane.columnIndex="0"/>
                <Label fx:id="durasiLabel" 
                       text="- hari"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';"
                       GridPane.rowIndex="3" 
                       GridPane.columnIndex="1"/>
                
                <Label text="Total Harga:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="3" 
                       GridPane.columnIndex="2"/>
                <Label fx:id="totalHargaLabel" 
                       text="Rp 0"
                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #e74c3c; -fx-font-family: 'Segoe UI';"
                       GridPane.rowIndex="3" 
                       GridPane.columnIndex="3"/>
                
            </GridPane>

            <!-- Tombol Aksi -->
            <HBox spacing="10" 
                  alignment="CENTER_LEFT">
                
                <Button fx:id="tambahButton" 
                       text="Tambah Reservasi" 
                       prefWidth="140.0"
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="ubahButton" 
                       text="Ubah" 
                       prefWidth="100.0"
                       style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand;"/>
                       
                <Button fx:id="batalkanButton" 
                       text="Batalkan" 
                       prefWidth="100.0"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="resetButton" 
                       text="Reset" 
                       prefWidth="100.0"
                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button fx:id="checkInButton" 
                       text="Check-in" 
                       prefWidth="100.0"
                       style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="checkOutButton" 
                       text="Check-out" 
                       prefWidth="100.0"
                       style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
            </HBox>
            
        </VBox>
    </bottom>

</BorderPane>