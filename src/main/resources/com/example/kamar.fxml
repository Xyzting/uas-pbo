<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="com.example.controller.KamarController"
            prefHeight="600.0"
            prefWidth="800.0"
            style="-fx-background-color: white;">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Tabel Kamar -->
    <center>
        <TableView fx:id="kamarTableView" 
                   BorderPane.alignment="CENTER"
                   style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="idKamarColumn" 
                            text="ID Kamar" 
                            prefWidth="150.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="tipeColumn" 
                            text="Tipe" 
                            prefWidth="200.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="hargaColumn" 
                            text="Harga" 
                            prefWidth="200.0"
                            minWidth="150.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <TableColumn fx:id="statusColumn" 
                            text="Status" 
                            prefWidth="150.0"
                            minWidth="100.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Form Input dan Tombol Aksi -->
    <bottom>
        <VBox spacing="15" 
              BorderPane.alignment="CENTER">
            
            <padding>
                <Insets top="15" right="0" bottom="0" left="0"/>
            </padding>
            
            <Separator style="-fx-background-color: #ecf0f1;"/>
            
            <!-- Form Input -->
            <GridPane hgap="10" vgap="12" 
                     alignment="CENTER_LEFT">
                
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" 
                                      minWidth="100.0" 
                                      prefWidth="100.0"/>
                    <ColumnConstraints hgrow="SOMETIMES" 
                                      minWidth="200.0" 
                                      prefWidth="300.0"/>
                </columnConstraints>
                
                <!-- ID Kamar -->
                <Label text="ID Kamar:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="0" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="idKamarField" 
                          promptText="Masukkan ID Kamar"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="0" 
                          GridPane.columnIndex="1"/>

                <!-- Tipe -->
                <Label text="Tipe:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="1" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="tipeField" 
                          promptText="Contoh: Standard, Deluxe, Suite"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="1" 
                          GridPane.columnIndex="1"/>

                <!-- Harga -->
                <Label text="Harga:" 
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                       GridPane.rowIndex="2" 
                       GridPane.columnIndex="0"/>
                <TextField fx:id="hargaField" 
                          promptText="Masukkan harga per malam"
                          style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-border-width: 1; -fx-font-size: 14px; -fx-padding: 10; -fx-font-family: 'Segoe UI';"
                          GridPane.rowIndex="2" 
                          GridPane.columnIndex="1"/>

                <!-- Status -->
               <Label text="Status:" 
                     style="-fx-font-size: 14px; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI'; -fx-font-weight: 600;"
                     GridPane.rowIndex="3" 
                     GridPane.columnIndex="0"/>
               <ComboBox fx:id="statusComboBox" 
                        promptText="Pilih Status"
                        prefWidth="200.0"
                        style="-fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                        GridPane.rowIndex="3" 
                        GridPane.columnIndex="1"/>
                
            </GridPane>

            <!-- Tombol Aksi -->
            <HBox spacing="10" 
                  alignment="CENTER_LEFT">
                
                <Button fx:id="tambahButton" 
                       text="Tambah" 
                       prefWidth="100.0"
                       style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="ubahButton" 
                       text="Ubah" 
                       prefWidth="100.0"
                       style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 5; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand;"/>
                       
                <Button fx:id="hapusButton" 
                       text="Hapus" 
                       prefWidth="100.0"
                       style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
                <Button fx:id="resetButton" 
                       text="Reset" 
                       prefWidth="100.0"
                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 20; -fx-cursor: hand;"/>
                       
            </HBox>
            
        </VBox>
    </bottom>

</BorderPane>